
//! A minimal hold-one-position strategy, used by the builder service's live smoke.

use vike_model::{Bar, Broker, Strategy};

pub struct LiveSmokeHold {
    qty: f64,
    warmup_bars: usize,
    entered: bool,
}

impl<B: Broker> Strategy<B> for LiveSmokeHold {
    fn warmup(&self) -> usize {
        self.warmup_bars
    }

    fn on_bar(&mut self, broker: &mut B, bar: &Bar) {
        if self.entered {
            return;
        }
        let symbol = bar.symbol.clone().unwrap_or_default();
        if symbol.is_empty() {
            return;
        }
        broker.submit_market(&symbol, 1, self.qty);
        self.entered = true;
    }
}

pub fn build<B: vike_model::HftBroker + 'static>(
    params: &toml::Value,
) -> Box<dyn vike_model::Strategy<B> + Send> {
    let qty = params
        .get("qty")
        .and_then(|v| v.as_float().or_else(|| v.as_integer().map(|i| i as f64)))
        .unwrap_or(1.0);
    let warmup_bars = params
        .get("warmup_bars")
        .and_then(|v| v.as_integer())
        .unwrap_or(0)
        .max(0) as usize;
    Box::new(LiveSmokeHold { qty, warmup_bars, entered: false })
}
