        let mut host_broker = ::vike_strategy_plugin::guest::HostBroker::new(broker);
        h.strategy.on_fill(&mut host_broker, &f);
        PluginStatus::Ok
    }));
    result.unwrap_or(PluginStatus::Panicked)
}

// ---- tier 3: the payloads no flat mirror can express ------------------------------------------

/// The L2 book, rebuilt on THIS side from the host's cursor — see
/// `vike_strategy_plugin::guest::book_from_ref` for what the rebuild costs and why a copy is
/// unavoidable whatever shape the payload takes.
///
/// SAFETY: see `vike_plugin_on_bar`'s doc; `book`'s `vtable` is host-owned and `'static` and its
/// `ctx` is valid for exactly this call.
#[unsafe(no_mangle)]
pub extern "C" fn vike_plugin_on_order_book(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_strategy_plugin::abi::BrokerRef,
    book: ::vike_strategy_plugin::abi::BookRef,
) -> ::vike_strategy_plugin::abi::PluginStatus {
    use ::vike_strategy_plugin::abi::PluginStatus;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() || book.vtable.is_null() {
            return PluginStatus::BadHandle;
        }
        // SAFETY: see `vike_plugin_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut PluginHandle) };
        let rebuilt = ::vike_strategy_plugin::guest::book_from_ref(book);
        let mut host_broker = ::vike_strategy_plugin::guest::HostBroker::new(broker);
        h.strategy.on_order_book(&mut host_broker, &rebuilt);
        PluginStatus::Ok
    }));
    result.unwrap_or(PluginStatus::Panicked)
}

/// ⚠ A `kind` code this plugin does not know answers `BadParams` and delivers NOTHING, rather
/// than delivering a guessed transition: a strategy's retry/refresh/abort machine keys off
/// exactly this tag, so an invented `Canceled` would make a live order look dead and free a slot
/// that is still occupied.
///
/// SAFETY: see `vike_plugin_on_bar`'s doc.
#[unsafe(no_mangle)]
pub extern "C" fn vike_plugin_on_order_event(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_strategy_plugin::abi::BrokerRef,
    event: *const ::vike_strategy_plugin::abi::COrderLifecycle,
) -> ::vike_strategy_plugin::abi::PluginStatus {
    use ::vike_strategy_plugin::abi::PluginStatus;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() || event.is_null() {
            return PluginStatus::BadHandle;
        }
        // SAFETY: see `vike_plugin_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut PluginHandle) };
        let Some(ev) = unsafe { &*event }.to_order_lifecycle() else {
            return PluginStatus::BadParams;
        };
        let mut host_broker = ::vike_strategy_plugin::guest::HostBroker::new(broker);
        h.strategy.on_order_event(&mut host_broker, &ev);
        PluginStatus::Ok
    }));
    result.unwrap_or(PluginStatus::Panicked)
}

/// The live-parameter bag, as the JSON document the host serialised it to —
/// `vike_strategy_plugin::guest::strategy_params_from_json` carries the argument for JSON over
/// TOML (measured: `toml` REFUSES the `None` fields `StrategyParams` reaches) and over a flat
/// mirror. A document this plugin cannot decode answers `BadParams` and swaps NOTHING, so the
/// strategy keeps running the tunables it already had rather than a half-applied bag.
///
/// SAFETY: see `vike_plugin_on_bar`'s doc.
#[unsafe(no_mangle)]
pub extern "C" fn vike_plugin_on_params_updated(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_strategy_plugin::abi::BrokerRef,
    params_ptr: *const u8,
    params_len: usize,
) -> ::vike_strategy_plugin::abi::PluginStatus {
    use ::vike_strategy_plugin::abi::PluginStatus;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return PluginStatus::BadHandle;
        }
        let json =
            ::vike_strategy_plugin::abi::CStrRef { ptr: params_ptr, len: params_len }.read();
        let Some(params) = ::vike_strategy_plugin::guest::strategy_params_from_json(&json) else {
            return PluginStatus::BadParams;
        };
        // SAFETY: see `vike_plugin_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut PluginHandle) };
        let mut host_broker = ::vike_strategy_plugin::guest::HostBroker::new(broker);
        h.strategy.on_params_updated(&mut host_broker, &params);
        PluginStatus::Ok
    }));
    result.unwrap_or(PluginStatus::Panicked)
}
