///
/// Returns null on a panic OR on a params parse failure: a host that gets null back must treat
/// creation as refused, never dereference the result.
#[unsafe(no_mangle)]
pub extern "C" fn vike_plugin_create(
    params_ptr: *const u8,
    params_len: usize,
) -> *mut ::std::ffi::c_void {
    let created = ::std::panic::catch_unwind(|| {
        // SAFETY: the host owns `params_ptr`/`params_len` for the duration of THIS call only,
        // per the borrowed-(ptr,len) contract every crossing string in `abi` follows.
        let bytes = unsafe { ::std::slice::from_raw_parts(params_ptr, params_len) };
        let text = ::std::str::from_utf8(bytes).ok()?;
        // ⚠ `toml::from_str`, NOT `text.parse()`, and the difference is the whole strategy.
        // Under the workspace's pinned `toml` 1.1, `<toml::Value as FromStr>` parses a single
        // VALUE EXPRESSION, not a document — so `"qty = 2.5"` comes back as
        // `unexpected content, expected nothing` and even `""` fails. This line WAS `.parse()`,
        // and the consequence was silent and total: every `vike_plugin_create` returned null,
        // every dispatch reported `PluginStatus::BadHandle`, and a plugin-loaded strategy traded
        // NOTHING while the artifact built, loaded and handshook cleanly. Found by
        // `crates/vike-strategy-plugin/tests/equivalence.rs`, which is the one test that drives a
        // plugin all the way to a trade list. Every other params read in this tree — the
        // build-time tier's own `crates/vike-user-strategies/src/codegen.rs` included — already
        // spells it this way.
        let params: ::toml::Value = ::toml::from_str(text).ok()?;
        let strategy = build::<::vike_strategy_plugin::guest::HostBroker>(&params);
        Some(Box::into_raw(Box::new(PluginHandle { strategy })) as *mut ::std::ffi::c_void)
    });
    match created {
        Ok(Some(handle)) => handle,
        Ok(None) | Err(_) => ::std::ptr::null_mut(),
    }
}

