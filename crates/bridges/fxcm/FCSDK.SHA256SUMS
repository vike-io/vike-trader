# ForexConnect SDK provenance record (2026-07 hardening).
# vendor/fcsdk is GITIGNORED (proprietary — never committed); this manifest pins what the
# dev box builds against so a silently swapped SDK is detectable. ForexConnect is a Windows
# C++ SDK, so the -Include below covers the Windows layout (dll/lib/so/h); add *.dylib,*.exe
# if a macOS/other SDK is ever vendored. Regenerate + re-verify:
#   Get-ChildItem vendor/fcsdk -Recurse -Include *.dll,*.lib,*.so,*.h -File | Sort-Object FullName |
#     ForEach-Object { "{0}  {1}" -f (Get-FileHash $_ -Algorithm SHA256).Hash.ToLower(), ($_.FullName -replace ".*vendor.fcsdk.","fcsdk/" -replace "\\","/") }
# A mismatch on refresh means the SDK changed — record WHY (new version, new download source).
