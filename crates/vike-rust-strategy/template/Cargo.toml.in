# The cdylib TEMPLATE's manifest. Rendered by `crates/vike-strategy-builder/src/render.rs`'s
# `render_cargo_toml` into a SCRATCH directory outside this checkout — never a workspace member
# (see `render.rs`'s module doc for why that is safe: Cargo resolves each `path` dependency's own
# `workspace = true` fields against ITS OWN enclosing workspace, not against this scratch crate).
#
# Ten double-curly placeholders below, substituted by `render_cargo_toml` and nowhere else —
# spelled out here WITHOUT their braces, deliberately, so this header comment does not itself
# contain a second copy of a placeholder for `.replace()` to find and corrupt (the exact bug
# `lib.rs.in`'s own header comment had until this template's first real lane run caught it):
#   NAME                     — the sanitized strategy/package name
#   VIKE_MARKETDATA_PATH     — absolute path to the real `vike-marketdata` in the same checkout
#                              (the market-data vocabulary a user file names: `Bar`, the ticks).
#   VIKE_MODEL_PATH          — absolute path to the real `vike-model` in the checkout that is
#                              currently building this template
#   VIKE_RUST_STRATEGY_PATH — absolute path to the real `vike-rust-strategy`, same checkout
#   VIKE_STRATEGY_PATH       — absolute path to the real `vike-strategy`, same checkout
#   VIKE_INDICATORS_PATH     — absolute path to the real `vike-indicators`, same checkout
#   VIKE_TACTICS_PATH        — absolute path to the real `vike-tactics`, same checkout
#   VIKE_UTIL_PATH           — absolute path to the real `vike-utility`, same checkout
#   VIKE_MM_PATH             — absolute path to the real `vike-market-making`, same checkout
#   VIKE_VENUES_PATH         — absolute path to the real `vike-venues`, same checkout

[package]
name = "{{NAME}}"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
# The one property this whole design rests on: an `extern "C"` boundary, not a Rust ABI one.
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
# `OrderBroker`/`Strategy` and `Bar` — the SAME two crates a file compiled in-process
# (`crates/vike-strategies-check/src/takers.rs`) writes against, so a strategy
# author's `use vike_model::{OrderBroker, Strategy};` + `use vike_marketdata::Bar;` lines are
# unchanged by which mechanism loads their file.
vike-marketdata = { path = "{{VIKE_MARKETDATA_PATH}}" }
vike-model = { path = "{{VIKE_MODEL_PATH}}" }
# The Controller/PositionExecutor framework and the indicator catalog — the OTHER two crates of
# the user-strategy API surface (`crates/vike-ops/tests/docs/user_strategy_surface_gate.rs`'s
# `USER_SURFACE`). They are here because decision 3 of
# `docs/superpowers/specs/2026-09-21-runtime-loaded-rust-strategies-design.md` ("one folder, the
# HOST decides the mechanism") is false for any user file that names one of them while only ONE
# mechanism can resolve it.
#
# ⚠ What they cost is MEASURED, not assumed, and the measurement is in the design doc beside the
# artifact figure it moved. Availability is near-free (an unnamed crate is dead code the linker
# drops); USE is not, and the catalog in particular is a static table of the whole indicator
# roster. `tests/equivalence.rs`'s `FLOOR_SOURCE` artifact is the figure that prices availability
# apart from use.
#
# ⚠ They bring `vike-market-making` and `tracing` with them (measured, not inferred — the design doc carries
# the `cargo tree` delta). `tracing`'s dispatcher is a process-GLOBAL, so a statically linked
# strategy file has its own: the duplicate-`static`s trap the design named. Since `ABI_VERSION` 9 the
# host's loader hands the file its log slot at load (`lib.rs.in`'s `vike_strategy_set_log`), and the
# file's dispatcher forwards every event to it, so a file's warning is logged by the host.
#
# ⚠ **This is `34b8d6756` partially undone, and that commit is the one to check this against.**
# `34b8d6756` split the builder out of this very crate for the EXPLICIT stated purpose of keeping
# `tracing` (and `vike-datahub-client`) OUT of a compiled strategy file's tree — "a strategy file should be tens
# of kilobytes, not megabytes," in its own words. Naming `vike-strategy` here brings `tracing`
# straight back, by a path that commit never touched: `vike-strategy` -> `vike-market-making` -> `tracing`,
# not the builder's own dependency graph.
#
# What that split actually refused is still refused: `vike-datahub-client` — the builder's
# authenticated wire protocol — names no path anywhere in this file. And what returns is narrower
# than what was removed, and OPT-IN rather than unconditional: a strategy file naming neither
# `vike-strategy` nor `vike-indicators` pays nothing for their presence (the FLOOR artifact costs
# 24 bytes LESS with them offered than without — see above), where the pre-split defect taxed
# EVERY strategy file regardless of what it used. That is the accepted trade, not the same accident back.
#
# ⚠ **Where the split's own language stops holding, said plainly rather than qualified away: a
# strategy file that DOES name `vike-strategy` is megabytes, not "tens of kilobytes."** +1.50 MiB over the
# floor, measured on the equivalence fixture. Read this as a QUALIFICATION of `34b8d6756`, not its
# reversal: the +1.50 MiB is overwhelmingly the indicator CATALOG (a static table over all 171
# indicators), which `tracing` rides in on rather than causes, and it is the direct, MEASURED price
# of decision 3 ("one folder, the host decides the mechanism") — a later ruling `34b8d6756` predates
# and could not have weighed against. A strategy file that stays at the floor keeps the split's promise; one
# that reaches for the shared framework spends megabytes on the framework, and `tracing` is a
# rounding error inside that spend, not its cause.
vike-strategy = { path = "{{VIKE_STRATEGY_PATH}}" }
vike-indicators = { path = "{{VIKE_INDICATORS_PATH}}" }
# The order language (`vike_tactics::Rule` run by `vike_tactics::RuleRun`, decision 0269), offered from
# `ABI_VERSION` 5, when `guest::HostBroker` grew `vike_model::OrderBroker`: a user file that writes
# its orders in it builds as a strategy file exactly as a built-in strategy does. It names only `vike-model`
# and `vike-marketdata`, both already here, so it brings no new crate behind it.
vike-tactics = { path = "{{VIKE_TACTICS_PATH}}" }
# Three more user-facing crates, from plan 2b (every strategy is a file): `vike-utility` (the shared
# helpers: 139 of the gallery's rules reach them), `libm` (the platform-identical transcendentals 15
# gallery rules call directly; an indicator keeps `libm`, never the platform `f64` methods) and
# `vike-market-making` (the market maker's maths, which the maker FILE computes with). None brings a crate the
# template did not already link: `vike-strategy` depends on `vike-market-making` and `libm`, `vike-tactics` on
# `vike-utility`. `libm`'s version is
# copied by hand from the root manifest's pin, like `toml`'s below.
vike-utility = { path = "{{VIKE_UTIL_PATH}}" }
libm = "0.2"
vike-market-making = { path = "{{VIKE_MM_PATH}}" }
# The per-venue tables (`vike_venues::fee_lane`, `fee_schedule_for`: a venue's static fee lane), which
# the funding-carry file reads (plan 2b C1's finding). Layer 12, on `vike-model` and `vike-utility` alone;
# `vike-strategy` already depends on it. It holds credential key NAMES, never a value.
vike-venues = { path = "{{VIKE_VENUES_PATH}}" }
# And two the maker files need (plan 2b C2's finding): `serde` with `derive`, for the restart state
# they save as typed documents, and `tracing`, for their edge-triggered warnings. Both are already in
# every strategy file's tree (`vike-model` derives serde; `vike-market-making` logs through tracing). Versions
# copied by hand from the root manifest, like `toml`'s below.
serde = { version = "1", features = ["derive"] }
tracing = "0.1"
# The wrapper's own C-ABI vocabulary (`abi::*`) and the guest-side `OrderBroker` implementation
# (`guest::HostBroker`) this template's `lib.rs.in` instantiates `build::<B>` with.
#
# ⚠ **The one dependency that is DELIBERATELY not user-facing surface**, and the gate named above
# carries it as a declared, argued exemption (`TEMPLATE_ONLY`) rather than tolerating it silently:
# a file compiled in-process needs no FFI vocabulary because there is no boundary to cross. It is the
# MECHANISM's own crate, not part of the user-facing surface.
vike-rust-strategy = { path = "{{VIKE_RUST_STRATEGY_PATH}}" }
# The PARSER of the params document the host hands `vike_strategy_create` as text: `lib.rs.in`
# deserializes it with `toml::from_str` into the `vike_model::params::Params` every `build`
# constructor reads. Like `vike-rust-strategy` above, it is the MECHANISM's crate and not the
# user-facing surface: a user file reads `&Params` and names no `toml`. Same pinned version the
# root workspace uses, so the strategy file parses with the `toml` the host rendered the text with (this
# crate is NOT a workspace member, so `{ workspace = true }` does not resolve here; the version is
# copied by hand and must be bumped alongside the root's own `toml` pin).
toml = "1.1"
# `serde_json::Value`, which `vike_model::Strategy::save_state` and `load_state` NAME in their
# signatures: from `ABI_VERSION` 8 a strategy file overrides them and keeps its restart state as a
# built-in does, and a file cannot spell a type its crate does not depend on. User-facing surface
# (a `USER_SURFACE` row of the gate named above). It
# brings no crate behind it: `vike-model` already depends on it. Copied by hand like `toml`'s pin.
serde_json = { version = "1", features = ["float_roundtrip"] }

[profile.release]
# Mirrors the root workspace's own `[profile.release]` (opt-level 3, thin LTO) so a strategy file's
# optimisation level does not silently diverge from the host binary's — one of the two facts
# `vike_rust_strategy::fingerprint` (Task 4) folds into the toolchain fingerprint both sides
# compare.
opt-level = 3
lto = "thin"
