// ---- tier 3: the payloads no flat mirror can express ------------------------------------------

/// The L2 book, rebuilt on THIS side from the host's cursor — see
/// `vike_rust_strategy::guest::book_from_ref` for what the rebuild costs and why a copy is
/// unavoidable whatever shape the payload takes.
///
/// SAFETY: see `vike_strategy_on_bar`'s doc; `book`'s `vtable` is host-owned and `'static` and its
/// `ctx` is valid for exactly this call.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_on_order_book(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_rust_strategy::abi::BrokerRef,
    book: ::vike_rust_strategy::abi::BookRef,
) -> ::vike_rust_strategy::abi::StrategyFileStatusAbi {
    use ::vike_rust_strategy::abi::StrategyFileStatusAbi;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() || book.vtable.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        // SAFETY: see `vike_strategy_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let rebuilt = ::vike_rust_strategy::guest::book_from_ref(book);
        let mut host_broker = ::vike_rust_strategy::guest::HostBroker::new(broker);
        h.strategy.on_order_book(&mut host_broker, &rebuilt);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}

/// ⚠ A `kind` code this strategy file does not know answers `BadParams` and delivers NOTHING, rather
/// than delivering a guessed transition: a strategy's retry/refresh/abort machine keys off
/// exactly this tag, so an invented `Canceled` would make a live order look dead and free a slot
/// that is still occupied.
///
/// SAFETY: see `vike_strategy_on_bar`'s doc.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_on_order_event(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_rust_strategy::abi::BrokerRef,
    event: *const ::vike_rust_strategy::abi::OrderEventAbi,
) -> ::vike_rust_strategy::abi::StrategyFileStatusAbi {
    use ::vike_rust_strategy::abi::StrategyFileStatusAbi;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() || event.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        // SAFETY: see `vike_strategy_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let Some(ev) = unsafe { &*event }.to_order_lifecycle() else {
            return StrategyFileStatusAbi::BadParams;
        };
        let mut host_broker = ::vike_rust_strategy::guest::HostBroker::new(broker);
        h.strategy.on_order_event(&mut host_broker, &ev);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}

/// The live-parameter bag, as the JSON document the host serialised it to —
/// `vike_rust_strategy::guest::strategy_params_from_json` carries the argument for JSON over
/// TOML (measured: `toml` REFUSES the `None` fields `StrategyParams` reaches) and over a flat
/// mirror. A document this strategy file cannot decode answers `BadParams` and swaps NOTHING, so the
/// strategy keeps running the tunables it already had rather than a half-applied bag.
///
/// SAFETY: see `vike_strategy_on_bar`'s doc.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_on_params_updated(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_rust_strategy::abi::BrokerRef,
    params_ptr: *const u8,
    params_len: usize,
) -> ::vike_rust_strategy::abi::StrategyFileStatusAbi {
    use ::vike_rust_strategy::abi::StrategyFileStatusAbi;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        let json =
            ::vike_rust_strategy::abi::StrAbi { ptr: params_ptr, len: params_len }.read();
        let Some(params) = ::vike_rust_strategy::guest::strategy_params_from_json(&json) else {
            return StrategyFileStatusAbi::BadParams;
        };
        // SAFETY: see `vike_strategy_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let mut host_broker = ::vike_rust_strategy::guest::HostBroker::new(broker);
        h.strategy.on_params_updated(&mut host_broker, &params);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}
