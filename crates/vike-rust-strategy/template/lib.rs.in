/// Restore the user strategy's state (`Strategy::load_state`, `ABI_VERSION` 8) from the JSON
/// document the host serialised it to, borrowed for this call. A document this strategy file
/// cannot decode answers `BadParams` and restores NOTHING, never a half-read state.
///
/// SAFETY: as `vike_strategy_inputs`; `(state_ptr, state_len)` is the host's for this call only.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_load_state(
    handle: *mut ::std::ffi::c_void,
    state_ptr: *const u8,
    state_len: usize,
) -> ::vike_rust_strategy::abi::StrategyFileStatusAbi {
    use ::vike_rust_strategy::abi::StrategyFileStatusAbi;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        let json = ::vike_rust_strategy::abi::StrAbi { ptr: state_ptr, len: state_len }.read();
        let Some(state) = ::vike_rust_strategy::guest::state_from_json(&json) else {
            return StrategyFileStatusAbi::BadParams;
        };
        // SAFETY: see `vike_strategy_inputs`' doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        h.strategy.load_state(&state);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}

/// The file's own refusal of a params document (its optional `refuse` export, `ABI_VERSION` 9), asked
/// BEFORE any strategy is created — a file's `build` may panic on the very params it refuses —
/// and answered as `vike_strategy_params` answers: the inner `None` is no refusal, or a file with no
/// `refuse` export; the outer `None` a caught panic or a document that does not parse. The text is
/// LENT from this thread's buffer until the thread's next `vike_strategy_refuse`.
///
/// SAFETY: `(params_ptr, params_len)` is the host's for this call only.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_refuse(
    params_ptr: *const u8,
    params_len: usize,
) -> ::vike_rust_strategy::abi::OptionAbi<
    ::vike_rust_strategy::abi::OptionAbi<::vike_rust_strategy::abi::StrAbi>,
> {
    use ::vike_rust_strategy::abi::{OptionAbi, StrAbi};
    ::std::thread_local! {
        static LENT: ::std::cell::RefCell<String> = const { ::std::cell::RefCell::new(String::new()) };
    }
    let lent = ::std::panic::catch_unwind(|| {
        let params = &params_from(params_ptr, params_len)?;
        let refusal: Option<String> = {{REFUSE}};
        let answer = refusal.map(|text| {
            LENT.with(|cell| {
                *cell.borrow_mut() = text;
                // The String stays in the thread-local until the next call replaces it.
                StrAbi::of(&cell.borrow())
            })
        });
        Some(OptionAbi::new(answer, StrAbi::empty()))
    });
    let none = OptionAbi::new(None, StrAbi::empty());
    OptionAbi::new(lent.ok().flatten(), none)
}

/// The file's effective-params line over the params the handle was created with (its optional
/// `echo` export, `ABI_VERSION` 9): the inner `None` is a file with no `echo` export, the text the
/// JSON `vike_rust_strategy::guest::echo_json` writes.
///
/// SAFETY: as `vike_strategy_inputs`.
