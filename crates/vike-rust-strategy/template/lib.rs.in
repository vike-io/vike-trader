    use ::vike_rust_strategy::abi::{OptionAbi, StrAbi};
    let lent = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return None;
        }
        // SAFETY: see this function's doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        h.lent = ::vike_rust_strategy::guest::names_json(&h.strategy.inputs());
        Some(StrAbi::of(&h.lent))
    }));
    OptionAbi::new(lent.ok().flatten(), StrAbi::empty())
}

