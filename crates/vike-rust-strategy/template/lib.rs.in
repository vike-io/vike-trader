/// The scheduled callback's TAG, as the borrowed `(ptr, len)` every string in this ABI uses.
///
/// SAFETY: see `vike_strategy_on_bar`'s doc; `(tag_ptr, tag_len)` is the host's for this call only.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_on_schedule(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_rust_strategy::abi::BrokerRef,
    tag_ptr: *const u8,
