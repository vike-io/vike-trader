/// creation as refused, never dereference the result.
///
/// `(facts_ptr, facts_len)` is the mount's `vike_model::params::MountFacts` as JSON, borrowed the
/// same way (`ABI_VERSION` 9); empty text states none, text that is not a facts document is null.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_create(
    params_ptr: *const u8,
    params_len: usize,
    facts_ptr: *const u8,
    facts_len: usize,
) -> *mut ::std::ffi::c_void {
