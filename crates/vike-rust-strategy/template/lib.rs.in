/// The params document the host lends as `(params_ptr, params_len)`, parsed: `None` for bytes that
/// are not UTF-8 or not a TOML document. Shared by `vike_strategy_create` and `vike_strategy_refuse`.
fn params_from(params_ptr: *const u8, params_len: usize) -> Option<::vike_model::params::Params> {
    // SAFETY: the host owns `params_ptr`/`params_len` for the duration of THIS call only,
    // per the borrowed-(ptr,len) contract every crossing string in `abi` follows.
    // An empty document may come as a null pointer, which `from_raw_parts` must never see.
    let bytes: &[u8] = if params_len == 0 {
        &[]
    } else {
        unsafe { ::std::slice::from_raw_parts(params_ptr, params_len) }
    };
    let text = ::std::str::from_utf8(bytes).ok()?;
    // ⚠ `toml::from_str`, NOT `text.parse::<toml::Value>()`, and the difference is the whole
    // strategy. Under the workspace's pinned `toml` 1.1, `<toml::Value as FromStr>` parses a
    // single VALUE EXPRESSION, not a document — so `"qty = 2.5"` comes back as
    // `unexpected content, expected nothing` and even `""` fails. This line WAS `.parse()`,
    // and the consequence was silent and total: every `vike_strategy_create` returned null,
    // every dispatch reported `StrategyFileStatusAbi::BadHandle`, and a strategy-file-loaded strategy traded
    // NOTHING while the artifact built, loaded and handshook cleanly. Found by
    // `crates/vike-rust-strategy/tests/equivalence.rs`, which is the one test that drives a
    // strategy file all the way to a trade list. The DOCUMENT is deserialized straight into
    // `vike_model::params::Params` (serde), so `toml` is this wrapper's PARSER only: the user
    // file below `build` reads `&Params` and names no `toml`.
    let params: ::vike_model::params::Params = ::toml::from_str(text).ok()?;
    Some(params)
}

/// Drop the strategy and free the handle. A null `handle` is a no-op — the host's own contract,
/// mirrored from every other FFI teardown site in this tree.
///
/// # Safety (documented for the SITE below, per this crate's `unsafe` convention)
/// `handle` must be exactly what `vike_strategy_create` returned on THIS strategy file, not yet destroyed.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_destroy(handle: *mut ::std::ffi::c_void) {
    if handle.is_null() {
        return;
    }
    let _ = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        // SAFETY: `handle` is non-null and, by the contract on this function, was produced by
        // `vike_strategy_create` on this strategy file and has not been destroyed yet.
        drop(unsafe { Box::from_raw(handle as *mut StrategyFileHandle) });
    }));
}

/// The user's declared warmup — how many bars the R2 gate (`index >= warmup()`,
/// `crates/vike-backtest/src/engine.rs` / `crates/vike-core/src/runtime/strategy_drive.rs`) skips
/// before this instance's `on_bar` is ever called (`vike_model::Strategy::warmup`'s own default is
/// `0`, no warmup).
///
/// ⚠ **A caught panic (or a null `handle`) must NOT return `0`.** Unlike `vike_strategy_on_bar`,
/// this export's wire signature (fixed by `loader.rs`'s `bind!` call and `host.rs`'s
/// `StrategyVTableAbi`) is a bare `usize` with no `StrategyFileStatusAbi` channel — so there is no way to say
/// "this call failed" distinct from "this strategy legitimately declares no warmup", and `0` is
/// exactly the value a HEALTHY strategy commonly returns. That is this file's own "a caught panic
/// must not read as a real answer" rule, restated for a count instead of a price. `usize::MAX` is
/// the one answer that can never be a plausible real warmup: fed back through the R2 gate, it
/// means this instance's `on_bar` is never admitted — the fail-SAFE direction for a strategy whose
/// own `warmup()` panicked, rather than one that silently trades from state its constructor never
/// finished setting up. (`crates/vike-backtest/src/engine.rs`'s `warmup` field is a plain `usize`
/// used only as that comparison, so `usize::MAX` here changes no arithmetic elsewhere — it just
/// never opens the gate.) A null `handle` — never produced by the real host path, which
/// short-circuits on it before calling this export at all, per `host.rs`'s
/// `StrategyFileHost::warmup` — is treated the same way, for the same reason.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_warmup(handle: *mut ::std::ffi::c_void) -> usize {
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return usize::MAX;
        }
        // SAFETY: `handle` is non-null and, by `vike_strategy_create`'s contract, was produced by
        // that call on this strategy file and has not been destroyed yet. `Strategy::warmup` takes
        // `&self`, so a shared reference is enough.
        let h = unsafe { &*(handle as *const StrategyFileHandle) };
        h.strategy.warmup()
    }));
    result.unwrap_or(usize::MAX)
}

/// The names of the stored series the user's strategy reads (`Strategy::inputs`, `ABI_VERSION` 6),
/// as the JSON array text `vike_rust_strategy::guest::names_json` writes. The text is kept in the
