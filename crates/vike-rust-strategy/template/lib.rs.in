        let params = params_from(params_ptr, params_len)?;
        let facts_text = ::vike_rust_strategy::abi::StrAbi { ptr: facts_ptr, len: facts_len }.read();
        let facts = if facts_text.is_empty() {
            ::vike_model::params::MountFacts::default()
        } else {
            ::vike_rust_strategy::guest::facts_from_json(&facts_text)?
        };
        let strategy: Box<
            dyn ::vike_model::Strategy<::vike_rust_strategy::guest::HostBroker> + Send,
        > = {{ENTRY}};
        let handle = StrategyFileHandle { strategy, params, lent: String::new() };
        Some(Box::into_raw(Box::new(handle)) as *mut ::std::ffi::c_void)
    });
