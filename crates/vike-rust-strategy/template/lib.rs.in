    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        let tag = ::vike_rust_strategy::abi::StrAbi { ptr: tag_ptr, len: tag_len }.read();
        // SAFETY: see `vike_strategy_on_bar`'s doc.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let mut host_broker = ::vike_rust_strategy::guest::HostBroker::new(broker);
        h.strategy.on_schedule(&mut host_broker, &tag);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}

/// ⚠ A `status` code this strategy file does not know answers `BadParams`, never a guessed variant: a
