        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let params = &h.params;
        let echo: Option<Vec<(&'static str, String)>> = {{ECHO}};
        let answer = echo.map(|pairs| {
            h.lent = ::vike_rust_strategy::guest::echo_json(&pairs);
            StrAbi::of(&h.lent)
        });
        Some(OptionAbi::new(answer, StrAbi::empty()))
    }));
    let none = OptionAbi::new(None, StrAbi::empty());
    OptionAbi::new(lent.ok().flatten(), none)
}

// ---- dispatch ------------------------------------------------------------------------------
//
// ⚠ **Every `vike_model::Strategy` seam method is wired, since `ABI_VERSION` 8** — the last four
// (`symbols`, `params`, `save_state`, `load_state`) are the `vike_strategy_*` exports above, and
// `vike_rust_strategy::host::UNWIRED_HOOKS` is empty; its own doc says why it stays.
//
// ⚠ **This block used to wire `on_bar` ALONE and call it "the worked example".** That was a
// declared scope boundary, not a safe one: a user file overriding `on_fill` compiled, rendered
// here, linked, loaded and handshook, and then never received the hook — the same source
// producing different, entirely plausible numbers under the two mechanisms with no signal
// anywhere. `vike_strategy_builder::render::build_strategy_file` refuses a source that overrides
// anything still in `UNWIRED_HOOKS`, and wiring a hook here (plus its `StrategyVTableAbi` field, its
// `loader.rs` bind and its `WIRED_HOOKS` entry) is what lifts that refusal for it. Thirteen of
// them were lifted at `ABI_VERSION` 3.
//
// ⚠ **EVERY export below wraps its body in `catch_unwind` and none may return a neutral value on
// a caught panic.** A panic across a C-ABI frame is UB, so the wrapper is not optional — and
// `StrategyFileStatusAbi::Panicked` rather than `Ok` is what stops a caught panic reading, to the host, as
// a dispatch that happened. The host's own thunks carry the mirror-image guard for the OTHER
// direction (`host.rs`'s `guarded` and its `POISONED` latch); neither side's rule covers the
// other's, which is the correction that block's header records.
//
// The shape every one of them follows: null-check the handle and the payload, recover
// `&mut StrategyFileHandle`, copy the borrowed payload into an owned Rust value, wrap the `BrokerRef`
// as a `HostBroker`, call the matching `Strategy` method, answer `Ok`.

/// SAFETY (documented for the site, per this crate's convention, and shared by every dispatch
/// export below): `handle` is a live `StrategyFileHandle` from `vike_strategy_create`, not yet destroyed;
/// a payload pointer is non-null and aligned and the host owns what it points at for the duration
/// of this call; `broker`'s `vtable` is host-owned, `'static`, and non-null for the whole lifetime
/// of this loaded strategy file.
#[unsafe(no_mangle)]
pub extern "C" fn vike_strategy_on_bar(
    handle: *mut ::std::ffi::c_void,
    broker: ::vike_rust_strategy::abi::BrokerRef,
    bar: *const ::vike_rust_strategy::abi::BarAbi,
) -> ::vike_rust_strategy::abi::StrategyFileStatusAbi {
    use ::vike_rust_strategy::abi::StrategyFileStatusAbi;
    let result = ::std::panic::catch_unwind(::std::panic::AssertUnwindSafe(|| {
        if handle.is_null() || bar.is_null() {
            return StrategyFileStatusAbi::BadHandle;
        }
        // SAFETY: see the function-level doc above.
        let h = unsafe { &mut *(handle as *mut StrategyFileHandle) };
        let bar: ::vike_marketdata::Bar = unsafe { &*bar }.to_bar();
        let mut host_broker = ::vike_rust_strategy::guest::HostBroker::new(broker);
        h.strategy.on_bar(&mut host_broker, &bar);
        StrategyFileStatusAbi::Ok
    }));
    result.unwrap_or(StrategyFileStatusAbi::Panicked)
}

