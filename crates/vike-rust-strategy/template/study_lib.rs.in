// ---- the study ---------------------------------------------------------------------------------

/// Run the study once: `input` is the start message, `host` answers every request the study makes (from
/// any of its threads), and its finished answer is written to `output`.
#[unsafe(no_mangle)]
pub extern "C" fn vike_study_run(
    host: ::vike_rust_strategy::study::StudyHostAbi,
    input: ::vike_rust_strategy::study::BytesAbi,
    output: ::vike_rust_strategy::study::SinkAbi,
) {
    ::vike_rust_strategy::study::run_export(host, input, output, |link, input| {
        let entry: ::vike_user_research::StudyFn = study::run;
        ::vike_user_research::file::guest::run(
            entry,
            &input,
            ::std::sync::Arc::new(move |request: &[u8]| link.call(request)),
        )
    });
}

/// Answer one request the host makes of an object the study handed out (the store it passed to its one
/// backtest).
#[unsafe(no_mangle)]
pub extern "C" fn vike_study_serve(
    request: ::vike_rust_strategy::study::BytesAbi,
    output: ::vike_rust_strategy::study::SinkAbi,
) {
    ::vike_rust_strategy::study::serve_export(request, output, |request| {
        ::vike_user_research::file::guest::serve(&request)
    });
}
